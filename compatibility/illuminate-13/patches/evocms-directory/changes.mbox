From 7a384e2e7134c2367af1d8c9fa03eb8c3efbc851 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 9 Oct 2026 21:24:37 +0300
Subject: [PATCH 1/2] Submit the form token when changing the page size

---
 views/list.blade.php | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/views/list.blade.php b/views/list.blade.php
index 62122e2..c043aec 100644
--- a/views/list.blade.php
+++ b/views/list.blade.php
@@ -302,7 +302,7 @@
                 });
 
                 $('.limits select').on('change', function() {
-                    $.post("{{ route('directory::limit', $container->id) }}", {limit: $(this).val()}, function(response) {
+                    $.post("{{ route('directory::limit', $container->id) }}", {limit: $(this).val(), _token: $(this.form).find('[name="_token"]').val()}, function(response) {
                         location.reload();
                     });
                 });
-- 
