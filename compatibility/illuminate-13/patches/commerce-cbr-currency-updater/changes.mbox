From 599a552d3e949eb4eff322b6973a79ec6ddaa2e9 Mon Sep 17 00:00:00 2001
From: zif91 <zif91@users.noreply.github.com>
Date: Fri, 9 Oct 2026 21:31:14 +0300
Subject: [PATCH 1/2] Retry failed CBR updates without waiting for successful
 cache TTL

---
 install/assets/plugins/CBRCurrencyUpdater.tpl | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/install/assets/plugins/CBRCurrencyUpdater.tpl b/install/assets/plugins/CBRCurrencyUpdater.tpl
index 3ce9c96..70dda21 100644
--- a/install/assets/plugins/CBRCurrencyUpdater.tpl
+++ b/install/assets/plugins/CBRCurrencyUpdater.tpl
@@ -22,7 +22,7 @@ switch ($modx->event->name) {
             return;
         }
 
-        ci()->cache->getOrCreate('cbrupdater', function() use ($modx) {
+        $updateSucceeded = ci()->cache->getOrCreate('cbrupdater', function() use ($modx) {
             $currencies  = ci()->currency->getCurrencies();
             $defaultCode = ci()->currency->getDefaultCurrencyCode();
             $default     = $currencies[$defaultCode];
@@ -34,7 +34,7 @@ switch ($modx->event->name) {
             } catch (\Exception $e) {
                 $modx->logEvent(0, 3, $e->getMessage(), 'CBR Currency Updater');
                 set_error_handler($handler);
-                return true;
+                return false;
             }
 
             set_error_handler($handler);
@@ -51,6 +51,11 @@ switch ($modx->event->name) {
                 }
             }
 
+            if (!isset($values[$defaultCode]) || $values[$defaultCode] <= 0) {
+                $modx->logEvent(0, 3, 'Default currency rate missing from CBR feed', 'CBR Currency Updater');
+                return false;
+            }
+
             foreach ($values as $code => $value) {
                 if ($code != $defaultCode) {
                     $values[$code] = $values[$defaultCode] / $value;
@@ -82,6 +87,12 @@ switch ($modx->event->name) {
             return true;
         }, ['seconds' => 3600]);
 
+        // The shared cache stores callback results, including false. Failed
+        // updates must be retried on the next normal homepage request.
+        if (!$updateSucceeded) {
+            ci()->cache->forget('cbrupdater');
+        }
+
         break;
     }
 
-- 
2.23.0


From ad4c420b8047938d2270d41842df403c7244448f Mon Sep 17 00:00:00 2001
From: zif91 <zif91@users.noreply.github.com>
Date: Fri, 9 Oct 2026 21:53:51 +0300
Subject: [PATCH 2/2] Handle failed XML transport without poisoning subsequent
 CMS snippets

---
 install/assets/plugins/CBRCurrencyUpdater.tpl | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/install/assets/plugins/CBRCurrencyUpdater.tpl b/install/assets/plugins/CBRCurrencyUpdater.tpl
index 70dda21..8286b2b 100644
--- a/install/assets/plugins/CBRCurrencyUpdater.tpl
+++ b/install/assets/plugins/CBRCurrencyUpdater.tpl
@@ -27,18 +27,20 @@ switch ($modx->event->name) {
             $defaultCode = ci()->currency->getDefaultCurrencyCode();
             $default     = $currencies[$defaultCode];
 
-            $handler = set_error_handler(null);
+            $previousXmlErrors = libxml_use_internal_errors(true);
+            set_error_handler(static function () { return true; }, E_WARNING);
 
             try {
                 $xml = new \SimpleXMLElement('http://cbr.ru/scripts/XML_daily.asp', 0, true);
             } catch (\Exception $e) {
                 $modx->logEvent(0, 3, $e->getMessage(), 'CBR Currency Updater');
-                set_error_handler($handler);
                 return false;
+            } finally {
+                restore_error_handler();
+                libxml_clear_errors();
+                libxml_use_internal_errors($previousXmlErrors);
             }
 
-            set_error_handler($handler);
-
             $values = [
                 'RUB' => 1,
             ];
-- 
2.23.0

