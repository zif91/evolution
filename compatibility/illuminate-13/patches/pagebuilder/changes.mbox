From ecd2506aaef851afdd80a2001a355717fe867dfa Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 9 Oct 2026 21:31:06 +0300
Subject: [PATCH 2/3] Preserve imported richtext in active and initializing
 TinyMCE editors

---
 assets/plugins/pagebuilder/js/interaction.js | 28 ++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/assets/plugins/pagebuilder/js/interaction.js b/assets/plugins/pagebuilder/js/interaction.js
index 43de1c4..a56bf7a 100644
--- a/assets/plugins/pagebuilder/js/interaction.js
+++ b/assets/plugins/pagebuilder/js/interaction.js
@@ -272,6 +272,21 @@
                                 break;
                             }
 
+                            case 'richtext': {
+                                if (typeof values[field] !== 'undefined' && typeof values[field] !== 'object') {
+                                    var $textarea = $field.children('textarea'),
+                                        editor = typeof tinymce !== 'undefined' && tinymce.editors[$textarea.attr('id')];
+
+                                    $textarea.val(values[field]).data('importValue', values[field]);
+                                    if (editor && editor.initialized) {
+                                        editor.setContent(values[field]);
+                                        $textarea.removeData('importValue');
+                                    }
+                                }
+
+                                break;
+                            }
+
                             case 'imagecheckbox':
                             case 'checkbox': {
                                 if (typeof values[field] !== 'undefined') {
@@ -584,6 +599,19 @@
                         conf = $.extend({}, conf, options ? options : {});
 
                         conf.selector = '#' + $textarea.attr('id');
+                        var setup = conf.setup;
+                        conf.setup = function(editor) {
+                            if (typeof setup === 'function') {
+                                setup(editor);
+                            }
+                            editor.on('init', function() {
+                                var value = $textarea.data('importValue');
+                                if (typeof value !== 'undefined') {
+                                    editor.setContent(value);
+                                    $textarea.removeData('importValue');
+                                }
+                            });
+                        };
                         tinymce.init(conf);
                     }
                 },
-- 
