Subject: [PATCH 2/2] Keep module translations readable when host fallback
 locale is absent

---
 src/Controllers/ExampleController.php |  4 ++--
 src/Support/Translator.php            | 14 ++++++++++++++
 views/edit.blade.php                  |  6 +++---
 views/index.blade.php                 | 18 +++++++++---------
 views/layout.blade.php                |  2 +-
 5 files changed, 29 insertions(+), 15 deletions(-)
 create mode 100644 src/Support/Translator.php

diff --git a/src/Controllers/ExampleController.php b/src/Controllers/ExampleController.php
index 9142f08..15a0acd 100644
--- a/src/Controllers/ExampleController.php
+++ b/src/Controllers/ExampleController.php
@@ -43,7 +43,7 @@ class ExampleController
 
         if ($validator->fails()) {
             return redirect()->route('example::edit_item', $item->id)
-                ->with('error', __('example::global.some_errors'))
+                ->with('error', \EvolutionCMS\Example\Support\Translator::get('example::global.some_errors'))
                 ->withErrors($validator)
                 ->withInput();
         }
@@ -52,6 +52,6 @@ class ExampleController
         $item->save();
 
         return redirect()->route('example::index')
-            ->with('success', __('example::global.saved'));
+            ->with('success', \EvolutionCMS\Example\Support\Translator::get('example::global.saved'));
     }
 }
diff --git a/src/Support/Translator.php b/src/Support/Translator.php
new file mode 100644
index 0000000..5d705cd
--- /dev/null
+++ b/src/Support/Translator.php
@@ -0,0 +1,14 @@
+<?php
+
+namespace EvolutionCMS\Example\Support;
+
+class Translator
+{
+    public static function get($key, array $replace = [])
+    {
+        $value = __($key, $replace);
+
+        // Keep this module readable when the host has no fallback locale configured.
+        return $value === $key ? __($key, $replace, 'en') : $value;
+    }
+}
