From f7c8f7777273080cd1f8876fb3eec68c7271e9e6 Mon Sep 17 00:00:00 2001
From: zif91 <zif91@users.noreply.github.com>
Date: Fri, 9 Oct 2026 21:31:13 +0300
Subject: [PATCH 2/3] Acknowledge persisted payments without repeating payment
 side effects

---
 .../plugins/commerce/src/Processors/OrdersProcessor.php   | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/assets/plugins/commerce/src/Processors/OrdersProcessor.php b/assets/plugins/commerce/src/Processors/OrdersProcessor.php
index f434e04..17f785d 100644
--- a/assets/plugins/commerce/src/Processors/OrdersProcessor.php
+++ b/assets/plugins/commerce/src/Processors/OrdersProcessor.php
@@ -808,8 +808,8 @@ class OrdersProcessor implements \Commerce\Interfaces\Processor
         $commerce = ci()->commerce;
 
         if (is_array($payment_id) && !empty($payment_id['id']) && !empty($payment_id['order_id'])) {
-            $payment    = $payment_id;
-            $payment_id = $payment['id'];
+            $payment_id = $payment_id['id'];
+            $payment = $this->loadPayment($payment_id);
         } else {
             $payment = $this->loadPayment($payment_id);
         }
@@ -819,7 +819,9 @@ class OrdersProcessor implements \Commerce\Interfaces\Processor
         }
 
         if (!empty($payment['paid'])) {
-            throw new Exception('Payment ' . print_r($payment_id, true) . ' already paid!');
+            // Payment providers retry successful notifications. Acknowledge the
+            // persisted result without repeating status, history or email work.
+            return true;
         }
 
         $order_id = $payment['order_id'];
-- 
